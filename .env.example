# ==============================================================================
# Arrowstack B2B Order Platform — Environment Configuration Template
# Copy this file to .env before starting the platform with Docker Compose
# ==============================================================================

# PostgreSQL Database Configuration
POSTGRES_USER=arrowstack
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_DB=arrowstack

# Internal Docker Network Connection String
DATABASE_URL=postgresql://arrowstack:change_me_local_only@db:5432/arrowstack?schema=public

# Local Non-Docker Development Connection String (Uncomment if running without Docker)
# DATABASE_URL=postgresql://arrowstack:change_me_local_only@localhost:5432/arrowstack?schema=public

# Authentication & Security
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars_for_production
JWT_EXPIRES_IN=1d
COOKIE_SECURE=false

# CORS & Frontend Origins
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
PORT=4000
